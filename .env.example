# Copy to .env and adjust. No secrets belong here: Registrar has no login,
# stores no portal credentials and needs no API keys.

# Host address the web app is published on. Loopback by default. A private
# VPN / overlay address is fine; a public address or 0.0.0.0 is not.
REGISTRAR_HOST_BIND=127.0.0.1
REGISTRAR_HOST_PORT=8762

# Time zone for "today" (cycle windows, reminders, deadlines).
TZ=America/New_York

# Extra host names the app answers to, comma-separated (e.g. registrar.lan); empty = loopback only.
REGISTRAR_ALLOWED_HOSTS=
